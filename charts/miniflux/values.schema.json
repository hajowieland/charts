          "type": "string"
        },
        "repository": {
          "default": "ghcr.io/miniflux/miniflux",
          "title": "repository",
          "type": "string"
        },
        "tag": {
          "default": "2.2.8",
          "description": "Overrides the image tag whose default is the chart appVersion.",
          "title": "tag",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "pullPolicy",
        "tag"
