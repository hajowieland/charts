    "adminSecret": {
      "description": "Sets ADMIN_PASSWORD",
      "properties": {
        "enabled": {
          "default": false,
          "title": "enabled",
          "type": "boolean"
        },
        "secretKey": {
          "default": "",
          "title": "secretKey",
          "type": "string"
        },
        "secretName": {
          "default": "",
          "title": "secretName",
          "type": "string"
        }
      },
      "required": [
